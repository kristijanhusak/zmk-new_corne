#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

&lt {
    quick-tap-ms = <175>;
};

&mt {
    quick-tap-ms = <175>;
    flavor = "tap-preferred";
};

// Key position groups for home row mods
#define KEYS_L  0  1  2  3  4  5 13 14 15 16 17 18 28 29 30 31 32 33
#define KEYS_R  7  8  9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41
#define THUMBS_L 42 43 44
#define THUMBS_R 45 46 47

// Home row mods only hold with the opposite hand (thumbs included)
#define MAKE_HRM(NAME, HOLD, TAP, TRIGGERS) \
    NAME: NAME { \
        compatible = "zmk,behavior-hold-tap"; \
        #binding-cells = <2>; \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <175>; \
        require-prior-idle-ms = <150>; \
        hold-trigger-key-positions = <TRIGGERS>; \
        hold-trigger-on-release; \
        bindings = <HOLD>, <TAP>; \
    };

/ {
    behaviors {
        MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS_R)
        MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS_L)

        // Thumb layer-taps (no hold-trigger positions, so they hold with same-side keys)
        thumb_lt: thumb_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <100>;
            bindings = <&mo>, <&kp>;
        };

        // Shift when held (as soon as another key goes down), Tab when tapped alone
        sft_tab: sft_tab {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        // ] on tap, Alt on hold, Ctrl+] on double tap
        td_rbkt: td_rbkt {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp RBKT>, <&kp LC(RBKT)>;
        };

        rbkt_alt: rbkt_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            bindings = <&kp>, <&td_rbkt>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

   combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };

        nav_home {
            bindings = <&kp HOME>;
            key-positions = <22 23>;
            layers = <1>;
        };

        nav_end {
            bindings = <&kp END>;
            key-positions = <24 25>;
            layers = <1>;
        };


        // Home row combos need a pause before them, so rolls don't trigger them
        grave {
            bindings = <&kp GRAVE>;
            key-positions = <14 15>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <15 16>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };

        nav_pgdn {
            bindings = <&kp PG_DN>;
            key-positions = <36 37>;
            layers = <1>;
        };

        nav_pgup {
            bindings = <&kp PG_UP>;
            key-positions = <38 39>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB    &kp Q        &kp W        &kp E         &kp R         &kp T    /* */ &none             /* */  &kp Y        &kp U           &kp I         &kp O        &kp P            &kp BSLH
&kp ESC    &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G  /* */ &none &none &none /* */  &kp H      &hmr LSHFT J    &hmr LCTRL K  &hmr LALT L  &hmr LGUI SEMI  &kp SQT
&kp LCTRL  &kp Z        &kp X        &kp C         &kp V         &kp B    /* */ &none  &none      /* */  &kp N        &kp M           &kp COMMA     &kp DOT      &kp FSLH         &mo 4
                                     &thumb_lt 2 LBKT    &thumb_lt 1 SPACE   &sft_tab LSHFT TAB                               &thumb_lt 2 ENTER  &thumb_lt 1 BSPC      &rbkt_alt LALT 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans     &kp N1      &kp N2      &kp N3      &kp N4      &kp N5       /* */ &none             /* */  &kp N6      &kp N7    &kp N8    &kp N9     &kp N0    &kp DEL
&lt 4 ESC  &kp LGUI    &kp LALT    &kp LCTRL   &kp LSHFT   &caps_word   /* */ &none &none &none /* */  &kp LEFT    &kp DOWN  &kp UP    &kp RIGHT  &trans    &kp INS
&mo 3      &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)  &kp LA(N5)   /* */ &none  &none      /* */  &kp LA(N6)  &kp LBKT  &kp RBKT  &trans     &trans    &kp PRINTSCREEN
                                   &trans      &trans      &trans                                      &trans  &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        symbol_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH      &kp DLLR      &kp PRCNT  /* */ &none             /* */  &kp CARET  &kp AMPS   &kp ASTRK  &trans  &trans  &trans
&trans  &kp GRAVE  &kp MINUS  &kp LPAR      &kp RPAR      &kp EQUAL  /* */ &none &none &none /* */  &trans     &trans     &trans     &trans  &trans  &trans
&trans  &kp TILDE  &kp UNDER  &kp LS(LBKT)  &kp LS(RBKT)  &kp PLUS   /* */ &none  &none      /* */  &trans     &trans     &trans     &trans  &trans  &trans
                              &trans        &trans        &trans                                    &trans     &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  /* */ &none             /* */  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  /* */ &none &none &none /* */  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  /* */ &none  &none      /* */  &mkp MB4        &trans          &trans        &mkp MB5         &trans  &trans
                        &trans  &trans  &trans                                 &mkp LCLK       &mkp RCLK       &mkp MCLK
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
&studio_unlock   &kp F1            &kp F2           &kp F3        &kp F4        &kp F5       /* */ &none             /* */  &kp F6        &kp F7          &kp F8       &kp F9   &kp F10     &kp F11
&trans           &kp LGUI          &kp LALT         &kp LCTRL     &kp LSHFT     &trans       /* */ &none &none &none /* */  &kp HOME      &kp PG_DN       &kp PG_UP    &kp END  &trans      &kp F12
&rgb_ug RGB_TOG  &rgb_ug RGB_BRI   &rgb_ug RGB_BRD  &trans        &sys_reset    &bootloader  /* */ &none  &none      /* */  &bootloader   &sys_reset      &trans       &trans   &trans      &trans
                                   &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2                                              &bt BT_SEL 3  &bt BT_CLR_ALL  &out OUT_USB
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
